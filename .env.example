# Copy to .env and fill in. Never commit .env.

APP_URL=http://localhost:3001

# --- Postgres (docker compose: `pnpm db:up`) ---
DATABASE_URL=postgres://portal:portal@localhost:5433/revopshq_client

# --- Outgoing mail for magic links ---
# Defaults point at Mailpit from docker compose; view mail at http://localhost:8026.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RevOps HQ <portal@revopshq.com>"

# --- HubSpot (private app in hubspot/, Auth tab → access token) ---
# Unset in development: sign-in works for any email but no HubSpot data is shown.
HUBSPOT_ACCESS_TOKEN=
# Ticket pipelines clients may see. Default "0" is HubSpot's default Support Pipeline.
HUBSPOT_TICKET_PIPELINE_IDS=0
# Where tickets opened from the portal go. Pipeline defaults to the first of the visible
# pipelines above (it must be one of them); stage defaults to that pipeline's first stage.
HUBSPOT_NEW_TICKET_PIPELINE_ID=
HUBSPOT_NEW_TICKET_STAGE_ID=
# Hosts invoice "View & pay" links may point at.
HUBSPOT_INVOICE_URL_HOSTS=clients.revopshq.com

# --- RevProjects ---
REVPROJECTS_API_URL=
REVPROJECTS_API_TOKEN=
